{
  "name": "agentic-bible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist --glob 'articles/**/*.html'",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "test:docs": "node scripts/validate-docs.mjs",
    "test": "node --test tests/static.test.mjs",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright test",
    "validate": "npm run test:docs && npm run check && npm run build && npm test && npm run test:editorial && npm run test:monitoring && npm run test:settings && npm run test:integration && npm run test:http-sources && npm run test:http-worker && npm run test:publication && npm run test:seo && npm run test:seo:build && npm run test:wiki-bridge && npm run test:corrections",
    "staging:check": "node scripts/assert-staging-discovery.mjs && XDG_CONFIG_HOME=.git/runtime-config XDG_CACHE_HOME=.git/runtime-cache WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.staging.jsonc",
    "staging:local": "node scripts/assert-staging-discovery.mjs && CLOUDFLARE_CF_FETCH_ENABLED=false XDG_CONFIG_HOME=.git/runtime-config XDG_CACHE_HOME=.git/runtime-cache WRANGLER_SEND_METRICS=false wrangler dev --local --config wrangler.staging.jsonc --ip 127.0.0.1 --port 8787",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright install chromium",
    "editorial:migrate": "XDG_CONFIG_HOME=.git/runtime-config XDG_CACHE_HOME=.git/runtime-cache WRANGLER_SEND_METRICS=false wrangler d1 migrations apply EDITORIAL_DB --local --config wrangler.editorial.local.jsonc --persist-to .wrangler/editorial",
    "editorial:local": "CLOUDFLARE_CF_FETCH_ENABLED=false XDG_CONFIG_HOME=.git/runtime-config XDG_CACHE_HOME=.git/runtime-cache WRANGLER_SEND_METRICS=false wrangler dev --local --config wrangler.editorial.local.jsonc --persist-to .wrangler/editorial --ip 127.0.0.1 --port 8788",
    "test:editorial": "node --test tests/editorial/*.test.ts",
    "test:editorial:browser": "PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright test --config playwright.editorial.config.ts",
    "test:monitoring": "node --test tests/monitoring/*.test.ts tests/monitoring/*.test.mjs",
    "test:settings": "node --test tests/settings/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:integration:browser": "PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright test --config playwright.integration.config.ts",
    "test:monitoring:worker": "node --test tests/monitoring-worker/*.test.mjs",
    "test:settings:worker": "node --test tests/settings-worker/*.test.mjs",
    "test:http-sources": "node --test tests/http-sources/*.test.ts",
    "test:http-worker": "node --test tests/http-worker/*.test.mjs",
    "test:publication": "node --test tests/publishing/*.test.ts",
    "test:publication:browser": "PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright test --config playwright.publication.config.ts",
    "publication:demo": "node scripts/article-publication.mjs demo",
    "publication:local": "node scripts/article-publication.mjs preview",
    "test:combined:browser": "PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright test --config playwright.combined.config.ts",
    "wiki-bridge:prepare": "node scripts/wiki-bridge.mjs prepare",
    "wiki-bridge:apply": "node scripts/wiki-bridge.mjs apply",
    "wiki-bridge:status": "node scripts/wiki-bridge.mjs status",
    "wiki-bridge:local": "node scripts/wiki-bridge.mjs preview",
    "test:wiki-bridge": "node --import ./tests/support/network-diagnostics.mjs --test tests/wiki-bridge/*.test.mjs",
    "test:wiki-bridge:browser": "PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright test --config playwright.wiki-bridge.config.ts",
    "test:seo": "node --test tests/seo/policy.test.ts tests/seo/outbox.test.mjs",
    "test:seo:build": "node --test tests/seo/build.test.mjs",
    "indexing:queue": "node scripts/indexing-outbox.mjs queue",
    "indexing:status": "node scripts/indexing-outbox.mjs status",
    "test:wiki-seo:browser": "AGENTIC_BIBLE_DISCOVERY_MODE=production AGENTIC_BIBLE_CANONICAL_ORIGIN=https://agenticbible.si PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright test --config playwright.wiki-seo-integration.config.ts",
    "corrections:local": "node scripts/reviewed-corrections.mjs",
    "test:corrections": "node --import ./tests/support/network-diagnostics.mjs --test tests/corrections/*.test.mjs",
    "test:corrections:browser": "PLAYWRIGHT_BROWSERS_PATH=.git/playwright playwright test --config playwright.corrections.config.ts"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  }
}
