---
import Base from '../layouts/Base.astro';
import { library } from '../lib/library';
import {articleIds} from '../editorial/contracts.ts';
const articles = (await library()).filter(article=>articleIds.includes(article.id as typeof articleIds[number]));
// Fail the build if choices drift from the same compiled inventory enforced by intake.
if (articles.length !== articleIds.length || new Set(articles.map(article => article.id)).size !== articleIds.length || articles.some(article => !articleIds.some(id => id === article.id))) throw new Error('incomplete_contribution_inventory');
---
<Base title="Correction options" description="Check an article’s sources and revision record. Reader correction intake is currently closed.">
  <link rel="stylesheet" href="/editorial.css" />
  <div class="editorial contribution">
    <header class="page-intro"><p class="eyebrow">Article feedback</p><h1>Correction options</h1><p>Compare a claim with the cited evidence and revision record before drawing a conclusion.</p></header>
    <div class="contribution-layout">
      <section aria-labelledby="form-title">
        <h2 id="form-title">Reader correction intake</h2>
        <p id="intake-status" role="status">Reader submissions are currently closed. This page cannot send a suggestion, and no reader submission route is available.</p>
        <div id="article-context" class="notice article-context" hidden>
          <p>Correction context for <strong id="context-title"></strong>.</p>
          <p>Review the article’s <a id="context-sources">cited sources</a> and <a id="context-revision">revision record</a> to identify the specific claim and evidence.</p>
        </div>
        <div id="receipt" class="notice" hidden tabindex="-1"></div>
        <form id="contribution-form" novalidate hidden>
          <fieldset disabled id="contribution-fields">
            <legend class="sr-only">Suggestion details</legend>
            <label for="article-id">Article</label>
            <select id="article-id" name="articleId" aria-describedby="articleId-error">{articles.map(article => <option value={article.id}>{article.data.title}</option>)}</select>
            <p class="field-error" id="articleId-error"></p>
            <label for="suggestion-kind">Suggestion type</label>
            <select id="suggestion-kind" name="kind" aria-describedby="kind-error"><option value="correction">Correction or clarification</option><option value="source">Additional primary source</option></select>
            <p class="field-error" id="kind-error"></p>
            <label for="suggestion-message">What needs attention?</label>
            <textarea id="suggestion-message" name="message" rows="7" minlength="20" maxlength="2000" required aria-describedby="message-help message-error"></textarea>
            <p id="message-help" class="field-help">20–2,000 characters. Plain text only. Describe the claim, the correction, and supporting evidence.</p>
            <p class="field-error" id="message-error"></p>
            <label for="source-url">Primary source URL <span class="optional">(required for a source suggestion)</span></label>
            <input id="source-url" name="sourceUrl" type="url" maxlength="500" placeholder="https://…" aria-describedby="source-help sourceUrl-error" />
            <p id="source-help" class="field-help">Public HTTPS URLs only. The server stores your link; it does not fetch or execute it.</p>
            <p class="field-error" id="sourceUrl-error"></p>
            <div class="honeypot" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
            <input type="hidden" name="requestKey" id="request-key" />
            <button id="send-suggestion" type="submit">Send suggestion</button>
            <button id="clear-draft" class="quiet-button" type="button">Clear draft</button>
            <button id="renew-reference" class="quiet-button" type="button" hidden aria-describedby="draft-recovery">Keep draft with new reference</button>
            <p id="draft-recovery" class="field-help" role="status" hidden>An earlier version may already be saved. Retry unchanged to confirm it, or use a new reference for the current draft. Your text and source will be kept.</p>
          </fieldset>
          <p id="form-error" role="alert"></p>
        </form>
      </section>
      <aside class="contribution-note"><p class="kicker">What readers can do</p><h2>Start with the evidence.</h2><p>Use the article’s cited primary documentation and revision record to check a specific claim. Reader submissions are closed, so this page does not collect or send a report.</p><p data-local-intake hidden>This is a local test flow. Use synthetic text, without personal data, credentials, or copied third-party article text.</p><p data-local-intake hidden>Your synthetic draft is retained in this tab's session storage until sent or cleared. Saved suggestions remain in the local database.</p><p id="hosted-intake-policy" hidden>Review the <a id="contribution-terms">contribution terms</a> and <a id="contribution-privacy">privacy policy</a>. Your draft remains in this tab until sent or cleared. Do not include credentials or personal data.</p><p>Where the private editorial workflow is available, authorized editors review suggestions there; that workspace is not a public reader channel.</p><a id="editorial-inbox-link" href="/admin/" hidden>Open local editorial inbox</a></aside>
    </div>
  </div>
  <style>
    .article-context { margin: 18px 0; }
    .article-context p { margin: 0; }
    .article-context p + p { margin-top: 8px; }
  </style>
  <script src="../scripts/contribute.ts"></script>
</Base>
