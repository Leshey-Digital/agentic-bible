---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { library, articleUrl, topicUrl, repository, sourceCommit } from '../../lib/library';
import {articleRevision} from '../../lib/article-revision';
export async function getStaticPaths() { return (await library()).map(article => ({ params: { id: article.id }, props: { article } })); }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const related = (await library()).filter(entry => article.data.related.includes(entry.id));
const publication=article.data.publication;
const corrections=publication?.reviewedCorrections;
const restoration=publication?.restoration;
const checkedDate=new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(article.data.verified+'T00:00:00Z'));
const revision=articleRevision(article.id,{sourceCommit});
const modifiedDate=revision&&new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${revision.date}T00:00:00Z`));
const history = sourceCommit ? `${repository}/commits/${sourceCommit}/src/content/articles/${article.id}.md` : null;
const canonicalArticleUrl=new URL(articleUrl(article.id),Astro.site??Astro.url).href;
const citation=`“${article.data.title}.” Agentic Bible. ${canonicalArticleUrl}`;
---
<Base title={article.data.title} description={article.data.description} active="library" seoArticle={article}>
  <div class="article-breadcrumb"><a href="/">Library</a><span>/</span><a href={topicUrl(article.data.topic)}>{article.data.topic}</a></div>
  <div class="reading-layout">
  <article class="article" data-pagefind-body>
    <header id="overview"><p class="eyebrow" data-pagefind-meta="topic">{article.data.topic} / Reference entry {String(article.data.order).padStart(2, '0')}</p><h1 data-pagefind-meta="title">{article.data.title}</h1><p class="article-deck" data-pagefind-meta="description">{article.data.description}</p><div class="article-status" data-pagefind-ignore><span class="draft-pill"><span class="status-dot"></span> {article.data.status}</span><span>{publication?(publication.flags.length?'Post-publication review flagged':'No post-publication flag supplied'):'Human editorial certification pending'}</span></div><nav class="article-actions" aria-label="Article actions" data-pagefind-ignore><a href="#sources">Sources ({article.data.sources.length})</a><a href="#revision">Revision history</a><a href="#share">Share or cite</a><a href={`/contribute/?article=${article.id}`}>Contribution options</a></nav></header>
    <aside class="contents" data-pagefind-ignore><details data-article-contents><summary>On this page</summary><nav aria-label="On this page"><a href="#overview">Overview</a>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}<a href="#sources">Sources & context</a><a href="#revision">Revision record</a></nav></details><div class="contents-bottom"><span class="eyebrow">Part of the collection</span><a href={topicUrl(article.data.topic)}>{article.data.topic} <svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div></aside>

    <div class="prose"><Content /></div>
    <p class="article-feedback" data-pagefind-ignore><a href={`/contribute/?article=${article.id}`}>Suggest a correction or primary source</a> · Public intake remains on hold; the local synthetic form covers only the original three entries.</p>
    <section class="sources" id="sources" aria-labelledby="sources-title" data-pagefind-ignore><p class="eyebrow">Follow the evidence</p><h2 id="sources-title">Sources & context</h2><p>{publication&&!corrections?<>Supplied evidence date: <time datetime={article.data.verified}>{article.data.verified}</time>. Source bytes match charged local observation receipts. Integrity binding is not factual or source-authenticity proof.</>:<>Primary sources checked on <time datetime={article.data.verified}>{checkedDate}</time>. A source check is not independent editorial approval.</>}</p><ol>{article.data.sources.map(source => <li id={`source-${source.id}`}><a href={source.url}>{source.title} <span aria-hidden="true"><svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a><span class="source-publisher">{source.publisher}</span><p>{source.context}</p>{publication?.evidence.filter(e=>e.citationId===source.id).map(e=><p>Bound original bytes: <code>{e.hash}</code> · Source <code>{e.sourceId}</code> · Receipt <code>{e.receiptKey}</code></p>)}</li>)}</ol></section>
    <section class="revision" id="revision" data-pagefind-ignore><h2>Revision record</h2><dl><div><dt>Authorship</dt><dd>{article.data.author}</dd></div><div><dt>Source check</dt><dd><time datetime={article.data.verified}>{checkedDate}</time>. This records source consultation, not editorial certification.</dd></div><div><dt>Human editorial review</dt><dd>{publication?'Post-publication follow-up is recorded; factual approval is unverified.':'Pending. No human editorial certification is recorded.'}</dd></div><div><dt>Latest source change</dt><dd>{revision&&modifiedDate?<><time datetime={revision.date}>{modifiedDate}</time> · {revision.subject} · <code>{revision.commit.slice(0,8)}</code></>:<>Unknown. Git source lineage is unavailable for this build.</>}</dd></div><div><dt>Revision receipt</dt><dd>{publication?<code>{publication.revisionId}</code>:'No separate publication receipt is recorded for this working draft.'}</dd></div></dl><p class="review-scope">The twenty entries received deep reading across external and internal review. Claim verification was sampled; this does not certify every factual claim.</p>{publication&&<><a class="text-link" href="/history/#article-tool-use">Read local revision history</a> · <a href="/review/">Post-publication flags</a><p>Pinned publisher snapshot: <code>{publication.publisherSnapshot}</code></p></>}{restoration&&<section><h3>Reviewed restoration</h3><p>Restored after a separate explicit admin approval. Earlier records and original source dates remain intact; factual accuracy and source freshness need follow-up.</p><p>Previous revision <code>{restoration.previousRevision}</code> · restored from <code>{restoration.restoredFromRevision}</code></p><a href={`/history/tool-use/restore-${restoration.approvalId}/`}>Read the restoration record</a></section>}{corrections&&<><h3>Reviewed correction attribution</h3><p>Local synthetic admin review; contributor identity and factual approval remain unverified. Source check dates above belong to the original article.</p><ol>{corrections.map(c=><li>Contribution <code>{c.submissionId}</code> · submission revision {c.submissionVersion} · reviewed by {c.reviewer} · approval <code>{c.approvalId}</code></li>)}</ol></>}{history?<a class="text-link" data-source-commit={sourceCommit} href={history}>View file history on GitHub <svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>:<p>Git file history is unavailable for this isolated preview.</p>}</section>
    <section class="share-tools" id="share" aria-labelledby="share-title" data-pagefind-ignore><p class="eyebrow">Keep a useful reference</p><h2 id="share-title">Share or cite this entry</h2><p id="article-citation" tabindex="0">{citation}</p><div class="share-buttons"><button type="button" data-copy-link hidden>Copy article link</button><button type="button" data-copy-citation hidden>Copy citation</button></div><p class="share-status" data-share-status role="status" aria-live="polite">The citation and link above remain available to copy manually if clipboard access is unavailable.</p></section>
    <section class="related" data-pagefind-ignore><p class="eyebrow">Keep exploring</p><h2>Connected ideas</h2>{related.map(entry => <a href={articleUrl(entry.id)}><span><span class="eyebrow">{entry.data.topic}</span><strong>{entry.data.title}</strong></span><span aria-hidden="true"><svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>)}</section>
  </article></div>
</Base>
<style>
  .article code { overflow-wrap:anywhere; }
  .share-tools { margin: 36px 0; padding: 24px; border: 1px solid var(--line); background: var(--surface); }
  .share-tools h2 { margin: 0 0 12px; font: 400 1.5rem/1.3 var(--serif); }
  .share-tools #article-citation { overflow-wrap:anywhere; }
  .share-buttons { display:flex; flex-wrap:wrap; gap:10px; }
  .share-buttons button { min-height:44px; padding:10px 14px; border:1px solid var(--green); border-radius:3px; background:transparent; color:var(--ink); font:inherit; cursor:pointer; }
  .share-buttons button:hover { background:#e7ecdf; }
  .share-buttons button:focus-visible { outline:3px solid var(--green); outline-offset:3px; }
  .share-status,.review-scope { color:var(--muted); font-size:.9rem; }
  @media(max-width:600px) { .share-tools { padding:18px; } .share-buttons button { flex:1 1 100%; } }
</style>

<script>
  const shareStatus = document.querySelector<HTMLElement>('[data-share-status]');
  const citationNode = document.querySelector<HTMLElement>('#article-citation');
  const linkButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const citationButton = document.querySelector<HTMLButtonElement>('[data-copy-citation]');
  const copy = async (value: string) => {
    try {
      if (!navigator.clipboard?.writeText) throw new Error('clipboard_unavailable');
      await navigator.clipboard.writeText(value);
      if (shareStatus) shareStatus.textContent = 'Copied to clipboard.';
    } catch {
      if (shareStatus) shareStatus.textContent = 'Copy failed. Select the visible citation or use the article address in your browser to copy it manually.';
    }
  };
  if (linkButton && citationButton && citationNode) {
    linkButton.hidden = false;
    citationButton.hidden = false;
    linkButton.addEventListener('click', () => void copy(window.location.href));
    citationButton.addEventListener('click', () => void copy(citationNode.textContent?.trim() ?? ''));
  }
  const contents = document.querySelector<HTMLDetailsElement>('[data-article-contents]');
  const desktop = window.matchMedia('(min-width: 721px)');
  if (contents) {
    contents.open = desktop.matches;
    desktop.addEventListener('change', event => { contents.open = event.matches; });
  }
</script>
