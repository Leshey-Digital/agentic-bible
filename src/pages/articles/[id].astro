---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { library, articleUrl, topicUrl, repository, sourceCommit } from '../../lib/library';
export async function getStaticPaths() { return (await library()).map(article => ({ params: { id: article.id }, props: { article } })); }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const related = (await library()).filter(entry => article.data.related.includes(entry.id));
const publication=article.data.publication;
const corrections=publication?.reviewedCorrections;
const restoration=publication?.restoration;
const checkedDate=new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(article.data.verified+'T00:00:00Z'));
const history = sourceCommit ? `${repository}/commits/${sourceCommit}/src/content/articles/${article.id}.md` : null;
---
<Base title={article.data.title} description={article.data.description} active="library" seoArticle={article}>
  <div class="article-breadcrumb"><a href="/">Library</a><span>/</span><a href={topicUrl(article.data.topic)}>{article.data.topic}</a></div>
  <div class="reading-layout">
  <article class="article" data-pagefind-body>
    <header id="overview"><p class="eyebrow" data-pagefind-meta="topic">{article.data.topic} / Reference entry {String(article.data.order).padStart(2, '0')}</p><h1 data-pagefind-meta="title">{article.data.title}</h1><p class="article-deck" data-pagefind-meta="description">{article.data.description}</p><div class="article-status" data-pagefind-ignore><span class="draft-pill"><span class="status-dot"></span> {article.data.status}</span><span>{publication?(publication.flags.length?'Post-publication review flagged':'No post-publication flag supplied'):'Editorial review pending'}</span></div><nav class="article-actions" aria-label="Article actions" data-pagefind-ignore><a href="#sources">Sources ({article.data.sources.length})</a><a href="#revision">Revision history</a><a href={`/contribute/?article=${article.id}`}>Contribution options</a></nav></header>
    <aside class="contents" data-pagefind-ignore><details data-article-contents><summary>On this page</summary><nav aria-label="On this page"><a href="#overview">Overview</a>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}<a href="#sources">Sources & context</a><a href="#revision">Revision record</a></nav></details><div class="contents-bottom"><span class="eyebrow">Part of the collection</span><a href={topicUrl(article.data.topic)}>{article.data.topic} <svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div></aside>

    <div class="prose"><Content /></div>
    <p class="article-feedback" data-pagefind-ignore><a href={`/contribute/?article=${article.id}`}>Suggest a correction or primary source</a> · Public intake remains on hold; the local synthetic form covers only the original three entries.</p>
    <section class="sources" id="sources" aria-labelledby="sources-title" data-pagefind-ignore><p class="eyebrow">Follow the evidence</p><h2 id="sources-title">Sources & context</h2><p>{publication&&!corrections?<>Supplied evidence date: <time datetime={article.data.verified}>{article.data.verified}</time>. Source bytes match charged local observation receipts. Integrity binding is not factual or source-authenticity proof.</>:<>Primary sources checked on <time datetime={article.data.verified}>{checkedDate}</time>. A source check is not independent editorial approval.</>}</p><ol>{article.data.sources.map(source => <li id={`source-${source.id}`}><a href={source.url}>{source.title} <span aria-hidden="true"><svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a><span class="source-publisher">{source.publisher}</span><p>{source.context}</p>{publication?.evidence.filter(e=>e.citationId===source.id).map(e=><p>Bound original bytes: <code>{e.hash}</code> · Source <code>{e.sourceId}</code> · Receipt <code>{e.receiptKey}</code></p>)}</li>)}</ol></section>
    <section class="revision" id="revision" data-pagefind-ignore><h2>Revision record</h2><dl><div><dt>Authorship</dt><dd>{article.data.author}</dd></div><div><dt>Editorial review</dt><dd>{publication?'Post-publication follow-up; factual approval unverified':'Pending · no reviewer assigned'}</dd></div><div><dt>This revision</dt><dd>{publication?<code>{publication.revisionId}</code>:'Sourced working draft; consult file history for revisions.'}</dd></div></dl>{publication&&<><a class="text-link" href="/history/#article-tool-use">Read local revision history</a> · <a href="/review/">Post-publication flags</a><p>Pinned publisher snapshot: <code>{publication.publisherSnapshot}</code></p></>}{restoration&&<section><h3>Reviewed restoration</h3><p>Restored after a separate explicit admin approval. Earlier records and original source dates remain intact; factual accuracy and source freshness need follow-up.</p><p>Previous revision <code>{restoration.previousRevision}</code> · restored from <code>{restoration.restoredFromRevision}</code></p><a href={`/history/tool-use/restore-${restoration.approvalId}/`}>Read the restoration record</a></section>}{corrections&&<><h3>Reviewed correction attribution</h3><p>Local synthetic admin review; contributor identity and factual approval remain unverified. Source check dates above belong to the original article.</p><ol>{corrections.map(c=><li>Contribution <code>{c.submissionId}</code> · submission revision {c.submissionVersion} · reviewed by {c.reviewer} · approval <code>{c.approvalId}</code></li>)}</ol></>}{history?<a class="text-link" data-source-commit={sourceCommit} href={history}>View file history on GitHub <svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>:<p>Git file history is unavailable for this isolated preview.</p>}</section>
    <section class="related" data-pagefind-ignore><p class="eyebrow">Keep exploring</p><h2>Connected ideas</h2>{related.map(entry => <a href={articleUrl(entry.id)}><span><span class="eyebrow">{entry.data.topic}</span><strong>{entry.data.title}</strong></span><span aria-hidden="true"><svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>)}</section>
  </article></div>
</Base>
<style>.article code { overflow-wrap:anywhere; }</style>

<script>
  const contents = document.querySelector<HTMLDetailsElement>('[data-article-contents]');
  const desktop = window.matchMedia('(min-width: 721px)');
  if (contents) {
    contents.open = desktop.matches;
    desktop.addEventListener('change', event => { contents.open = event.matches; });
  }
</script>
