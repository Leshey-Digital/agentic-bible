---
import Base from '../layouts/Base.astro';
import { library, articleUrl } from '../lib/library';
const articles = await library();
---
<Base title="Search the library" active="search"><header class="page-intro search-intro"><p class="eyebrow">Make a connection</p><h1>What are you exploring?</h1><p>Search the full text of all {articles.length} reference entries.</p></header><section class="search-panel" aria-label="Library search"><form id="search-form" role="search"><label for="search-input">Search the library</label><div class="search-field"><svg width="24" height="24" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.4"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.4"/></svg><input id="search-input" type="search" disabled placeholder="Try “tools” or “protocol”…" autocomplete="off" maxlength="180" aria-describedby="search-help" /><button type="submit" disabled>Search <span aria-hidden="true"><svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></button></div><p id="search-help">Searches article text as you type · Press Esc to clear</p></form><p id="search-status" role="status" aria-live="polite">Full-text search needs JavaScript. Browse all entries below.</p><div id="search-error" hidden><h2>Search is unavailable</h2><p>The search index could not be loaded. You can still browse every article below.</p><button type="button" id="search-retry" class="button">Retry search</button></div><ol id="search-results" class="search-results" aria-label="Search results" aria-busy="false"></ol><div id="no-results" hidden><h2>No connections yet.</h2><p>Try a broader term such as “agent”, “tools”, or “MCP”. This collection has {articles.length} entries.</p><button id="clear-search" type="button" class="text-link">Clear search <svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></button></div><section class="search-browse"><div class="section-heading"><h2>Browse the collection</h2><span>{articles.length} entries</span></div>{articles.map(a => <a href={articleUrl(a.id)}><span>{a.data.title}</span><span class="eyebrow">{a.data.topic} <svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>)}</section></section><script src="../scripts/search.ts"></script></Base>
