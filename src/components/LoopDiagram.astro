---
const { compact = false } = Astro.props;
---
<div class:list={['loop-diagram', { compact }]} aria-label="An agent loop: goal, decide, act, observe, then decide again" role="img">
  <div class="diagram-caption"><span>FIG. 01</span><span>THE AGENT LOOP</span></div>
  <div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div>
  <div class="diagram-center"><span class="diagram-star"><svg class="asterisk" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 4v32M4 20h32M9 9l22 22M9 31 31 9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg></span><span>Goal</span></div>
  <span class="loop-node node-one">01 <b>Decide</b></span>
  <span class="loop-node node-two">02 <b>Act</b></span>
  <span class="loop-node node-three">03 <b>Observe</b></span>
  <span class="diagram-arrow arrow-one"><svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 3l10 10M3 13h10V3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="diagram-arrow arrow-two"><svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 3 3 13M3 3v10h10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="diagram-arrow arrow-three"><svg class="icon-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14V2m-5 5 5-5 5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
  <div class="diagram-note">Action informed by feedback.</div>
</div>
